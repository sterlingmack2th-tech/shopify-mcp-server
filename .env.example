# Railway sets PORT automatically; default is used for local dev only.
PORT=3000

# Shopify store domain, e.g. true-silver-2.myshopify.com
SHOPIFY_STORE=

# Shopify app credentials used for the client-credentials token grant.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional: Admin API version to target (defaults to 2026-07).
SHOPIFY_API_VERSION=2026-07

# --- Claude / MCP OAuth 2.1 (separate from the Shopify credentials above) ---

# The public HTTPS URL this server is reachable at, no trailing slash or path.
# e.g. https://keen-tranquility-production-46af.up.railway.app
MCP_PUBLIC_URL=

# HMAC-SHA256 signing secret for MCP access tokens (>= 32 chars).
# Generate with: openssl rand -base64 32
MCP_OAUTH_SIGNING_SECRET=

# Password required on the OAuth consent screen before Claude is granted a
# token. Only you should know this. Generate with: openssl rand -base64 24
MCP_ADMIN_PASSWORD=

# Optional: a single pre-registered OAuth client for Claude Desktop's
# connector UI (enter these two values directly when adding the connector),
# as a simpler alternative to CIMD/DCR. Leave both unset to disable; if set,
# both must be present.
# CLAUDE_OAUTH_CLIENT_ID can be any unique string, e.g. "claude-desktop".
# Generate the secret with: openssl rand -base64 24
CLAUDE_OAUTH_CLIENT_ID=
CLAUDE_OAUTH_CLIENT_SECRET=
